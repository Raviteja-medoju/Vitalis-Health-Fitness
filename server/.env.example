# Create an API key at https://platform.claude.com (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=
PORT=8787
# Comma-separated origins allowed to call this server (web builds). Native apps don't send Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional: override the model (default claude-opus-5-5)
COACH_MODEL=claude-opus-5-5
